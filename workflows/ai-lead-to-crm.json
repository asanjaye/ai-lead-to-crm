        "specifyBody": "json",
        "jsonBody": "={\n  \"lead\": {\n    \"name\": \"{{ $json.lead.name }}\",\n    \"email\": \"{{ $json.lead.email }}\",\n    \"company\": {{ $json.lead.company ? '\"' + $json.lead.company + '\"' : 'null' }},\n    \"message\": \"{{ $json.lead.message.replace(/\"/g, '\\\\\"').replace(/\\n/g, '\\\\n') }}\",\n    \"source\": \"{{ $json.lead.source }}\"\n  },\n  \"include_draft_reply\": true\n}",
        "options": {
          "timeout": 60000
        }
      },
      "id": "classify-lead",
      "name": "AI Classification",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1130, 160],
