# =============================================================================
# AI Lead-to-CRM Workflow - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# Never commit .env with real credentials!

# -----------------------------------------------------------------------------
# LLM Configuration
# -----------------------------------------------------------------------------
# Provider: "openai" or "anthropic"
LLM_PROVIDER=openai

# OpenAI Configuration
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini

# Anthropic Configuration (if using Claude)
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here
ANTHROPIC_MODEL=claude-3-haiku-20240307

# -----------------------------------------------------------------------------
# n8n Configuration
# -----------------------------------------------------------------------------
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/

# Optional: Enable basic auth for n8n
N8N_BASIC_AUTH_ACTIVE=false
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=changeme

# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------
POSTGRES_USER=n8n
POSTGRES_PASSWORD=n8n_password
POSTGRES_DB=n8n

# -----------------------------------------------------------------------------
# Notification Configuration (for error alerts)
# -----------------------------------------------------------------------------
# Slack webhook for failure notifications (optional)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Email for failure notifications (optional, requires n8n email credentials)
NOTIFICATION_EMAIL=sanjaye@usc.edu

# -----------------------------------------------------------------------------
# General Settings
# -----------------------------------------------------------------------------
TIMEZONE=America/New_York
LOG_LEVEL=INFO

# Approval UI webhook (used by n8n to trigger approval flow)
N8N_WEBHOOK_URL=http://n8n:5678
